  <conditions>
    <condition id="levelx freertos condition">
    <require Cclass="RTOS" Cgroup="FreeRTOS" Csub="Core"/>
    <deny Cclass="File System" Cgroup="LevelX" Csub="No_OS"/>
  </condition>
  <condition id="LX Core condition">
    <description>levelx core dependency</description>
    <require condition="Use NOR Flash Core"/>
    <require condition="Use NAND Flash Core"/>
    <require condition="USE W25N01GVXX POLLING"/>
    <require condition="USE W25N01GVXX DMA NO OS"/>
    <require condition="USE W25N01GVXX DMA OS"/>
    <require condition="USE MX25LM51245G POLLING"/>
    <require condition="USE MX25LM51245G DMA NO OS"/>
    <require condition="USE MX25LM51245G DMA OS"/>
