      <require Cclass="File System" Cgroup="LevelX" Csub="w25n01gvxx_nand_dma_os_itf" />
    </condition>
    <condition id="USE MX66UW1G45G POLLING">
    </condition>
    <condition id="USE MX66UW1G45G DMA NO OS">
    </condition>
    <condition id="USE MX66UW1G45G DMA OS">
    </condition>
    <condition id="USE MX25LM51245G POLLING">
    </condition>
    <condition id="USE MX25LM51245G DMA NO OS">
    </condition>
    <condition id="USE MX25LM51245G DMA OS">
    </condition>
    <condition id="USE W25Q128J POLLING">
    </condition>
    <condition id="USE W25Q128J DMA NO OS">
    </condition>
    <condition id="USE W25Q128J DMA OS">
    </condition>
    <condition id="Operating System Used">
