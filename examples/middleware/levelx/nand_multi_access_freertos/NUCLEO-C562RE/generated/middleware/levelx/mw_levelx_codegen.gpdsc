    <require condition="USE MX66UW1G45G DMA NO OS"/>
    <require condition="USE MX66UW1G45G DMA OS"/>
    <require condition="USE W25Q128J POLLING"/>
    <require condition="USE W25Q128J DMA NO OS"/>
    <require condition="USE W25Q128J DMA OS"/>
    <require condition="Operating System Used"/>
  </condition>
    <condition id="Use NOR Flash Core">
    </condition>
    <condition id="Use NAND Flash Core">
      <require Cclass="File System" Cgroup="LevelX" Csub="NAND Flash Core" />
    </condition>
    <condition id="USE W25N01GVXX POLLING">
    </condition>
    <condition id="USE W25N01GVXX DMA NO OS">
