      - generator: syscalls_mx2codegen
        path: $SolutionDir()$/../generated/utilities/syscalls
  build-types:
    - type: debug_GCC
      compiler: GCC
    - type: release_GCC
      compiler: GCC
    - type: debug_IAR
      compiler: IAR
    - type: release_IAR
      compiler: IAR
    - type: debug_AC6
      compiler: AC6
    - type: release_AC6
      compiler: AC6
  projects:
    - project: project/stfcf_cipher_aes_cbc.cproject.yml
  packs:
