      "STMicroelectronics.advanced_trace.2.1.0$STMicroelectronics::Utility:STM32CubeMX2 Config:ADVANCED_TRACE@1.1.0#ADVANCED_TRACE Config": [
        {
          "index": 15,
          "instanceId": "26a3f229-f819-4370-894d-592b19048392",
          "name": "MyADVANCED_TRACE_1",
          "entity": "unknown",
          "settings": {
            "parameters": {
              "info": {
                "description": "Advanced Trace is a trace management system for STM32 microcontrollers. Use it for debugging or for communication with external systems, such as a console or monitoring tool, over UART or a custom I/O interface. The module stores trace data in a FIFO buffer and transfers it in the background using DMA.",
                "recommendation": "Configure the selected interface properly and enable DMA TX on the associated peripheral. Also ensure that the trace FIFO size is valid and that the FIFO memory location is in a valid writable memory region."
              },
              "basic": {
                "fifo_size": 256,
                "override_mem_section": false
              },
              "additional": {
                "buffer_size": 128,
                "trace_rx": true,
                "unchunk_mode": false,
                "trace_overrun": false,
                "conditional": true,
                "rx_user_cb": "adv_trace_rx_user_callback",
                "conditional_mode": {
                  "verbose_level": 0,
                  "region_mask": 4294967295,
                  "set_timestamp": false
                }
              },
              "resourcesAllocation": {
                "output_interface": "UART",
                "uart_instance": {
                  "bindingId": "193c49a4-ab12-4c92-9d60-a89dd8fd7073",
                  "bindingType": "bind.peripheral.config",
                  "selection": "USART2"
                }
              }
            }
          }
        }
