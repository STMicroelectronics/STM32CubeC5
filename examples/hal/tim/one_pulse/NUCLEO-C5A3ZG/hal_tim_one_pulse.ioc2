      "id": "b48f7f9b-b105-44e5-a7bf-c68c6e4e5bbb",
      "name": "application",
      "files": [
        "hal_tim_one_pulse.csolution.yml"
      ]
    }
  ],
  "children": [
    "NUCLEO-C5A3ZG_project/NUCLEO-C5A3ZG_project.hw"
  ]
}"""
