              "additional": {
                "enable_ti_mode": "DisableTI",
                "set_fifo_threshold": "1",
                "spi_io_configuration": {
                  "enable_mosi_miso_swap": false,
                  "lock_io_config": false,
                  "enable_master_keep_io_state": false
                },
                "enable_crc": false,
                "enable_delay_read_data_sampling": false,
