      "STMicroelectronics.basic_stdio.2.0.0$STMicroelectronics::Utility:STM32CubeMX2 Config:Basic stdio@1.0.0#Basic stdio Config": [
        {
          "index": 10,
          "instanceId": "32a3b9e0-f54c-45ac-ad55-42317c893989",
          "name": "MyBasic_stdio_1",
          "entity": "unknown",
          "settings": {
            "parameters": {
              "info": {
                "description": "The basic_stdio is a generic module provided to help the integration of a system trace inside an application by redirecting printf output to interfaces such as UART or ITM",
                "recommendation": "Transmission requires selecting and properly configuring one of the output peripherals—either UART or ITM with debug trace components activated, or your customized output peripheral."
              },
              "resourcesAllocation": {
